[Unit]
Description=Sotto desktop dictation client
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/opt/sotto-linux/current/sotto daemon
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
