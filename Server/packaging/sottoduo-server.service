[Unit]
Description=SottoDuo dictation server with optional desktop microphone capture
After=pipewire.service
Wants=pipewire.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/sottoduo/server.env
ExecStart=%h/.local/opt/sottoduo/current/sottoduo-server
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target
